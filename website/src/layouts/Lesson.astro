---
import "../styles/site.css";
import { url } from "../lib/url";
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Agent in a Box</title>
    <link rel="icon" href={url("/banner.svg")} />
  </head>
  <body>
    <header>
      <a href={url("/")}>Agent in a Box</a><a href={url("/chapters/0/")}>Chapter 0</a><a href={url("/chapters/5/")}>Chapter 5</a><a href={url("/glossary/")}>Glossary</a>
    </header>
    <main><slot /></main>
    <footer><p class="muted">Agent in a Box is in development. Results are labeled with where they came from; nothing on this site ran on your machine.</p></footer>
  </body>
</html>
