---
// What the evidence on this page is, shown before any result.
import Label from "./Label.astro";
const { label } = Astro.props;
const tools = label.toolchain;
const native = label.enforcement.filter((value) => value !== "analysis only");
---
<div class="banner" role="note">
  <p><strong><Label term="recorded" /> evidence</strong>, built {label.built} with Cedar {tools.cedar_policy},
    SymCC {tools.symcc}, and {tools.solver}.</p>
  {label.published && native.length === 0 && (
    <p>The solver and Cedar results on this page were produced when this site was built (analysis
      only: no agent ran). No native run recording has been published yet, so the run panels say
      so instead of showing a run.</p>
  )}
  {label.published && native.length > 0 && (
    <p>Run panels come from native recordings with enforcement: {native.join(", ")}.</p>
  )}
  {label.test_backend && (
    <p>Development build from test-backend bundles (enforcement: none): no kernel profile was
      installed. This page is never published.</p>
  )}
</div>
